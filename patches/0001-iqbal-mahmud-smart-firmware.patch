diff --git a/trunk/user/www/n56u_ribbon_fixed/Advanced_SpeedControl_Content.asp b/trunk/user/www/n56u_ribbon_fixed/Advanced_SpeedControl_Content.asp
new file mode 100644
index 000000000..63fcd568a
--- /dev/null
+++ b/trunk/user/www/n56u_ribbon_fixed/Advanced_SpeedControl_Content.asp
@@ -0,0 +1,346 @@
+<!DOCTYPE html>
+<html>
+<head>
+<title><#Web_Title#> - <#menu5_10_4#></title>
+<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
+<meta http-equiv="Pragma" content="no-cache">
+<meta http-equiv="Expires" content="-1">
+
+<link rel="shortcut icon" href="images/favicon.ico">
+<link rel="icon" href="images/favicon.png">
+<link rel="stylesheet" type="text/css" href="/bootstrap/css/bootstrap.min.css">
+<link rel="stylesheet" type="text/css" href="/bootstrap/css/main.css">
+
+<script type="text/javascript" src="/jquery.js"></script>
+<script type="text/javascript" src="/state.js"></script>
+<script type="text/javascript" src="/general.js"></script>
+<script type="text/javascript" src="/popup.js"></script>
+<script>
+
+<% login_state_hook(); %>
+
+/* Speed Control page - Iqbal Mahmud build */
+
+var sc_vip_v = '<% nvram_get_x("", "sc_vip"); %>';
+var sc_custom_v = '<% nvram_get_x("", "sc_custom"); %>';
+var sc_down_v = '<% nvram_get_x("", "sc_down"); %>';
+var sc_up_v = '<% nvram_get_x("", "sc_up"); %>';
+var rows = [];	// {mac, ip, name, rule: 'others'|'vip'|'custom', down, up}  (down/up in Mbps)
+
+function k2m(k){
+	var n = parseInt(k, 10);
+	if (isNaN(n)) return '';
+	var m = n / 1000;
+	return (Math.round(m * 1000) / 1000).toString();
+}
+
+function m2k(v){
+	return Math.round(parseFloat(v) * 1000);
+}
+
+function valid_mbps(v, allow_zero){
+	if (!/^[0-9]+(\.[0-9]+)?$/.test(v)) return false;
+	var f = parseFloat(v);
+	return allow_zero ? (f >= 0 && f <= 1000) : (f > 0 && f <= 1000);
+}
+
+function norm_mac(m){
+	m = m.replace(/-/g, ':').toLowerCase().replace(/\s/g, '');
+	return /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/.test(m) ? m : '';
+}
+
+function find_row(mac){
+	for (var i = 0; i < rows.length; i++)
+		if (rows[i].mac == mac) return i;
+	return -1;
+}
+
+function load_rows(){
+	var i, p, lines = document.getElementById('sc_devs').value.split('\n');
+	for (i = 0; i < lines.length; i++) {
+		p = lines[i].split('|');
+		if (p.length < 1 || !norm_mac(p[0])) continue;
+		rows.push({mac: norm_mac(p[0]), ip: p[1] || '', name: p[2] || '', rule: 'others', down: '', up: ''});
+	}
+	var vip = sc_vip_v.split(' ');
+	for (i = 0; i < vip.length; i++) {
+		var m = norm_mac(vip[i]);
+		if (!m) continue;
+		var r = find_row(m);
+		if (r < 0) { rows.push({mac: m, ip: '', name: '', rule: 'vip', down: '', up: ''}); }
+		else rows[r].rule = 'vip';
+	}
+	var cus = sc_custom_v.split(' ');
+	for (i = 0; i < cus.length; i++) {
+		p = cus[i].split(',');
+		var m2 = norm_mac(p[0] || '');
+		if (!m2) continue;
+		var r2 = find_row(m2);
+		if (r2 < 0) { rows.push({mac: m2, ip: '', name: '', rule: 'custom', down: k2m(p[1]), up: k2m(p[2])}); r2 = rows.length - 1; }
+		if (rows[r2].rule != 'vip') { rows[r2].rule = 'custom'; rows[r2].down = k2m(p[1]); rows[r2].up = k2m(p[2]); }
+	}
+}
+
+function save_inputs(){
+	for (var i = 0; i < rows.length; i++) {
+		var s = document.getElementById('rule_' + i);
+		if (!s) continue;
+		rows[i].rule = s.value;
+		rows[i].down = document.getElementById('down_' + i).value;
+		rows[i].up = document.getElementById('up_' + i).value;
+	}
+}
+
+function draw_rows(){
+	var h = '', i, r, sel;
+	if (rows.length == 0)
+		h = '<tr><td colspan="6" style="text-align:center; color:#888;"><#SC_no_devices#></td></tr>';
+	for (i = 0; i < rows.length; i++) {
+		r = rows[i];
+		sel = function(v){ return (r.rule == v) ? ' selected' : ''; };
+		h += '<tr>';
+		h += '<td>' + (r.name ? r.name : '-') + '</td>';
+		h += '<td>' + (r.ip ? r.ip : '<span style="color:#888;"><#SC_offline#></span>') + '</td>';
+		h += '<td style="font-family:monospace;">' + r.mac + '</td>';
+		h += '<td><select id="rule_' + i + '" class="input" style="width:150px;" onchange="rule_changed(' + i + ');">'
+			+ '<option value="others"' + sel('others') + '><#SC_rule_others#></option>'
+			+ '<option value="vip"' + sel('vip') + '><#SC_rule_vip#></option>'
+			+ '<option value="custom"' + sel('custom') + '><#SC_rule_custom#></option></select></td>';
+		h += '<td><input type="text" id="down_' + i + '" class="input" style="width:50px;" maxlength="7" value="' + r.down + '"/></td>';
+		h += '<td><input type="text" id="up_' + i + '" class="input" style="width:50px;" maxlength="7" value="' + r.up + '"/></td>';
+		h += '</tr>';
+	}
+	document.getElementById('sc_rows').innerHTML = h;
+	for (i = 0; i < rows.length; i++)
+		rule_changed(i);
+}
+
+function rule_changed(i){
+	var c = (document.getElementById('rule_' + i).value == 'custom');
+	document.getElementById('down_' + i).disabled = !c;
+	document.getElementById('up_' + i).disabled = !c;
+}
+
+function add_mac(){
+	var m = norm_mac(document.getElementById('new_mac').value);
+	if (!m) { alert('<#SC_bad_mac#>'); return; }
+	save_inputs();
+	if (find_row(m) < 0)
+		rows.push({mac: m, ip: '', name: '', rule: 'vip', down: '', up: ''});
+	document.getElementById('new_mac').value = '';
+	draw_rows();
+}
+
+function mode_changed(){
+	var pool = (document.form.sc_mode.value == 'pool');
+	showhide_div('hint_each', !pool);
+	showhide_div('hint_pool', pool);
+}
+
+function enable_changed(){
+	showhide_div('tbl_sc_settings', document.form.sc_enable.value == '1');
+}
+
+function initial(){
+	show_banner(1);
+	show_menu(5,8,4);
+	show_footer();
+	load_body();
+
+	document.getElementById('od_mbps').value = k2m(sc_down_v);
+	document.getElementById('ou_mbps').value = k2m(sc_up_v);
+	load_rows();
+	draw_rows();
+	mode_changed();
+	enable_changed();
+}
+
+function applyRule(){
+	var i, vip = [], cus = [];
+	save_inputs();
+
+	if (!valid_mbps(document.form.sc_line_down.value, false) || !valid_mbps(document.form.sc_line_up.value, false)) {
+		alert('<#SC_bad_plan#>'); document.form.sc_line_down.focus(); return;
+	}
+	var od = document.getElementById('od_mbps').value, ou = document.getElementById('ou_mbps').value;
+	if (!valid_mbps(od, true) || !valid_mbps(ou, true)) {
+		alert('<#SC_bad_speed#>'); document.getElementById('od_mbps').focus(); return;
+	}
+	for (i = 0; i < rows.length; i++) {
+		if (rows[i].rule == 'vip') vip.push(rows[i].mac);
+		else if (rows[i].rule == 'custom') {
+			if (!valid_mbps(rows[i].down, true) || !valid_mbps(rows[i].up, true)) {
+				alert('<#SC_bad_speed#> (' + rows[i].mac + ')'); document.getElementById('down_' + i).focus(); return;
+			}
+			cus.push(rows[i].mac + ',' + m2k(rows[i].down) + ',' + m2k(rows[i].up));
+		}
+	}
+	document.form.sc_down.value = m2k(od);
+	document.form.sc_up.value = m2k(ou);
+	document.form.sc_vip.value = vip.join(' ');
+	document.form.sc_custom.value = cus.join(' ');
+
+	showLoading();
+	document.form.action_mode.value = " Apply ";
+	document.form.current_page.value = "/Advanced_SpeedControl_Content.asp";
+	document.form.next_page.value = "";
+	document.form.submit();
+}
+
+function done_validating(action){
+	refreshpage();
+}
+</script>
+</head>
