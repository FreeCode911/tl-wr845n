+                                                <select name="sc_mode" class="input" style="width: 260px;" onchange="mode_changed();">
+                                                    <option value="each" <% nvram_match_x("", "sc_mode", "each", "selected"); %>><#SC_mode_each#></option>
+                                                    <option value="pool" <% nvram_match_x("", "sc_mode", "pool", "selected"); %>><#SC_mode_pool#></option>
+                                                </select>
+                                            </td>
+                                        </tr>
+                                        <tr>
+                                            <th><#SC_down#> / <#SC_up#> (Mbps)</th>
+                                            <td>
