diff --git a/trunk/user/scripts/speedctl.sh b/trunk/user/scripts/speedctl.sh
new file mode 100755
index 000000000..af59bb163
--- /dev/null
+++ b/trunk/user/scripts/speedctl.sh
@@ -0,0 +1,341 @@
+#!/bin/sh
+#
+# Speed Control for Padavan - by Iqbal Mahmud (iqbalmahmud.com)
+#
+# VIP devices      : full speed, and priority over everyone else
+# Custom devices   : their own download/upload limit
+# Everyone else    : "each" = every device gets its own limit
+#                    "pool" = all of them share one limit
+#
+# Devices are identified by MAC address, so rules survive IP changes.
+# Speeds are in Mbps ("5", "1.5") or kbps with a k ("512k"). 0 = unlimited.
+#
+# Usage (Administration -> Console, or SSH):
+#   speedctl list                      show connected devices and their rule
+#   speedctl status                    show settings and live classes
+#   speedctl on | off                  enable / disable Speed Control
+#   speedctl line DOWN UP              your real internet plan speed
+#   speedctl others each|pool DOWN UP  rule for everyone not listed
+#   speedctl vip add|del MAC           full-speed devices
+#   speedctl limit MAC DOWN UP         custom limit for one device
+#   speedctl unlimit MAC               remove a custom limit
+#   speedctl apply                     re-apply now
+#
+
+LAN=br0
+TAG=speedctl
+STATE=/tmp/speedctl
+PIDFILE=/var/run/speedctl.pid
+POLL=15
+MAXDEV=200
+
+log() { logger -t "$TAG" "$*"; }
+nvq() { nvram get "$1" 2>/dev/null; }
+nvd() { v="$(nvq "$1")"; [ -n "$v" ] && echo "$v" || echo "$2"; }
+
+# "5" "5m" "1.5" -> Mbps, "512k" -> kbps. Prints kbit, or nothing if invalid.
+to_kbit() {
+	echo "$1" | awk '{
+		v=tolower($0); m=1000
+		if (v ~ /k(bps|bit)?$/) { m=1; sub(/k(bps|bit)?$/,"",v) }
+		else sub(/m(bps|bit)?$/,"",v)
+		if (v !~ /^[0-9]+(\.[0-9]+)?$/) exit
+		printf "%d\n", v*m + 0.5
+	}'
+}
+
+fmt() {
+	[ -z "$1" ] || [ "$1" -eq 0 ] && { echo "unlimited"; return; }
+	if [ "$1" -ge 1000 ]; then
+		awk -v k="$1" 'BEGIN{ s=sprintf("%.1f",k/1000); sub(/\.0$/,"",s); print s " Mbps" }'
+	else
+		echo "$1 kbps"
+	fi
+}
+
+norm_mac() {
+	m="$(echo "$1" | tr 'A-F-' 'a-f:')"
+	echo "$m" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' && echo "$m"
+}
+
+wan_dev() { ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}'; }
+
+lan_mac() { cat /sys/class/net/$LAN/address 2>/dev/null; }
+
+# u32 matches for destination (at -14) and source (at -8) MAC on an ethernet device
+mac_dst_match() { echo "$1" | awk -F: '{printf "match u16 0x%s%s 0xffff at -14 match u32 0x%s%s%s%s 0xffffffff at -12", $1,$2,$3,$4,$5,$6}'; }
+mac_src_match() { echo "$1" | awk -F: '{printf "match u32 0x%s%s%s%s 0xffffffff at -8 match u16 0x%s%s 0xffff at -4", $1,$2,$3,$4,$5,$6}'; }
+
+in_list() { for x in $2; do [ "$x" = "$1" ] && return 0; done; return 1; }
+
+custom_get() {	# MAC -> "down up" kbit, or nothing
+	for e in $(nvq sc_custom); do
+		[ "${e%%,*}" = "$1" ] && { echo "$e" | awk -F, '{print $2, $3}'; return; }
+	done
+}
+
+connected_macs() {
+	ip neigh show dev $LAN 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") print tolower($(i+1))}' | sort -u
+}
+
+dev_name() {
+	n="$(awk -v m="$1" 'tolower($2)==m {print $4; exit}' /tmp/dnsmasq.leases 2>/dev/null)"
+	[ -z "$n" ] || [ "$n" = "*" ] && n="-"
+	echo "$n"
+}
+
+dev_ip() { ip -4 neigh show dev $LAN 2>/dev/null | awk -v m="$1" 'tolower($3)==m {print $1; exit}'; }
+
+# ---------------------------------------------------------------------------
+
+teardown() {
+	tc qdisc del dev $LAN root 2>/dev/null
+	[ -f "$STATE/wan" ] && tc qdisc del dev "$(cat "$STATE/wan")" root 2>/dev/null
+	for t in iptables ip6tables; do
+		command -v $t >/dev/null 2>&1 || continue
+		i=0; while [ $i -lt 5 ] && $t -t mangle -D PREROUTING -i $LAN -j SPEEDCTL 2>/dev/null; do i=$((i + 1)); done
+		$t -t mangle -F SPEEDCTL 2>/dev/null
+		$t -t mangle -X SPEEDCTL 2>/dev/null
+	done
+	rm -f "$STATE/sig" "$STATE/wan"
+}
+
+leaf() {	# dev classid-minor
+	tc qdisc add dev "$1" parent 1:$2 handle $2: sfq perturb 10 2>/dev/null
+}
+
+cls() {	# dev minor rate ceil prio
+	r="$3"; c="$4"
+	[ "$r" -gt "$c" ] && r="$c"
+	tc class add dev "$1" parent 1:1 classid 1:$2 htb rate ${r}kbit ceil ${c}kbit prio $5 quantum 1514
+	leaf "$1" "$2"
+}
+
+mark_rule() {	# MAC markid
+	for t in iptables ip6tables; do
+		command -v $t >/dev/null 2>&1 || continue
+		$t -t mangle -A SPEEDCTL -m mac --mac-source "$1" -j MARK --set-xmark $(printf '0x%x' $(($2 << 16)))/0xff0000 2>/dev/null
+	done
+}
+
+build() {
+	wan="$1"
+	modprobe -q sch_htb 2>/dev/null; modprobe -q sch_sfq 2>/dev/null
+	modprobe -q cls_u32 2>/dev/null; modprobe -q xt_mac 2>/dev/null; modprobe -q xt_mark 2>/dev/null
+
+	teardown
+
+	ld="$(to_kbit "$(nvd sc_line_down 30)")"; lu="$(to_kbit "$(nvd sc_line_up 30)")"
+	[ -z "$ld" ] || [ "$ld" -eq 0 ] && ld=100000
+	[ -z "$lu" ] || [ "$lu" -eq 0 ] && lu=100000
+	LD=$((ld * 95 / 100)); LU=$((lu * 95 / 100))
+
+	mode="$(nvd sc_mode each)"
+	od="$(nvd sc_down 5000)"; ou="$(nvd sc_up 1000)"
+	[ "$od" -eq 0 ] && od=$LD; [ "$ou" -eq 0 ] && ou=$LU
+	[ "$od" -gt "$LD" ] && od=$LD; [ "$ou" -gt "$LU" ] && ou=$LU
+
+	vip="$(nvq sc_vip)"
+	lanmac="$(lan_mac)"
+
+	# ---------- download: egress of LAN bridge ----------
+	ip link set $LAN txqueuelen 1000 2>/dev/null
+	tc qdisc add dev $LAN root handle 1: htb default 20 r2q 10 || { log "cannot create download shaper"; return 1; }
+	tc class add dev $LAN parent 1: classid 1:2 htb rate 50mbit ceil 100mbit prio 0 quantum 1514
+	leaf $LAN 2
+	tc class add dev $LAN parent 1: classid 1:1 htb rate ${LD}kbit ceil ${LD}kbit quantum 1514
+	cls $LAN 10 $((LD * 90 / 100)) $LD 0
+	cls $LAN 20 64 $od 1
+	[ -n "$lanmac" ] && tc filter add dev $LAN parent 1: protocol all prio 1 u32 $(mac_src_match "$lanmac") flowid 1:2
+
+	# ---------- upload: egress of WAN ----------
+	tc qdisc add dev "$wan" root handle 1: htb default 10 r2q 10 || { log "cannot create upload shaper on $wan"; tc qdisc del dev $LAN root 2>/dev/null; return 1; }
+	tc class add dev "$wan" parent 1: classid 1:1 htb rate ${LU}kbit ceil ${LU}kbit quantum 1514
+	cls "$wan" 10 $((LU * 90 / 100)) $LU 0
+	cls "$wan" 20 64 $ou 1
+	tc filter add dev "$wan" parent 1: protocol all prio 1 u32 match mark 0x10000 0xff0000 flowid 1:10
+	tc filter add dev "$wan" parent 1: protocol all prio 2 u32 match mark 0x20000 0xff0000 flowid 1:20
+
+	# ---------- marks for upload ----------
+	for t in iptables ip6tables; do
+		command -v $t >/dev/null 2>&1 || continue
+		$t -t mangle -N SPEEDCTL 2>/dev/null
+		$t -t mangle -F SPEEDCTL 2>/dev/null
+		$t -t mangle -A SPEEDCTL -j MARK --set-xmark 0x20000/0xff0000 2>/dev/null
+		$t -t mangle -C PREROUTING -i $LAN -j SPEEDCTL 2>/dev/null || $t -t mangle -I PREROUTING -i $LAN -j SPEEDCTL 2>/dev/null
+	done
+
+	n=0
+	add_dev() {	# MAC down up prio-class(0=vip)
+		n=$((n + 1)); [ $n -gt $MAXDEV ] && return
+		id=$((n + 16)); minor="$(printf '%x' $((256 + n)))"
+		if [ "$4" = vip ]; then
+			tc filter add dev $LAN parent 1: protocol all prio 2 u32 $(mac_dst_match "$1") flowid 1:10
+			mark_rule "$1" 1
+			return
+		fi
+		d="$2"; u="$3"
+		[ "$d" -eq 0 ] && d=$LD; [ "$u" -eq 0 ] && u=$LU
+		[ "$d" -gt "$LD" ] && d=$LD; [ "$u" -gt "$LU" ] && u=$LU
+		cls $LAN "$minor" 64 "$d" 1
+		cls "$wan" "$minor" 64 "$u" 1
+		tc filter add dev $LAN parent 1: protocol all prio 3 u32 $(mac_dst_match "$1") flowid 1:$minor
+		tc filter add dev "$wan" parent 1: protocol all prio 3 u32 match mark $(printf '0x%x' $((id << 16))) 0xff0000 flowid 1:$minor
+		mark_rule "$1" "$id"
+	}
+
+	for m in $vip; do add_dev "$m" 0 0 vip; done
+	for e in $(nvq sc_custom); do
+		m="${e%%,*}"; in_list "$m" "$vip" && continue
+		set -- $(echo "$e" | awk -F, '{print $2, $3}')
+		add_dev "$m" "${1:-0}" "${2:-0}" custom
+	done
+	if [ "$mode" = "each" ] && [ -f "$STATE/seen" ]; then
+		while read -r m; do
+			in_list "$m" "$vip" && continue
+			[ -n "$(custom_get "$m")" ] && continue
+			add_dev "$m" "$od" "$ou" each
+		done < "$STATE/seen"
+	fi
+
+	echo "$wan" > "$STATE/wan"
+	log "applied: mode=$mode others=$(fmt $od)/$(fmt $ou) line=$(fmt $ld)/$(fmt $lu) wan=$wan devices=$n"
+	return 0
+}
+
+signature() {
+	echo "$1|$(nvq sc_line_down)|$(nvq sc_line_up)|$(nvq sc_mode)|$(nvq sc_down)|$(nvq sc_up)|$(nvq sc_vip)|$(nvq sc_custom)|$(cat "$STATE/seen" 2>/dev/null | tr '\n' ' ')"
+}
+
+healthy() {	# wan
+	tc qdisc show dev $LAN 2>/dev/null | grep -q "htb 1:" || return 1
+	tc qdisc show dev "$1" 2>/dev/null | grep -q "htb 1:" || return 1
+	iptables -t mangle -C PREROUTING -i $LAN -j SPEEDCTL 2>/dev/null || return 1
+	return 0
+}
+
+export_devices() {	# for the web UI: mac|ip|name per line
+	connected_macs | while read -r m; do
+		echo "$m|$(dev_ip "$m")|$(dev_name "$m" | tr -cd 'A-Za-z0-9._-')"
+	done > /tmp/speedctl_devices.txt.tmp && mv /tmp/speedctl_devices.txt.tmp /tmp/speedctl_devices.txt
+}
+
+sync_now() {
+	mkdir -p "$STATE"
+	export_devices
+	if [ "$(nvd sc_enable 0)" != "1" ]; then
+		[ -f "$STATE/wan" ] && { teardown; log "disabled"; }
+		return 0
+	fi
+	case "$(nvq sfe_enable)" in
+	1|2)	# SFE skips the firewall marks, so limits would be bypassed
+		nvram set sfe_enable=0; nvram commit
+		log "Software Offload (SFE) turned off so speed limits work"
+		restart_firewall >/dev/null 2>&1
+		rm -f "$STATE/sig" ;;
+	esac
+	wan="$(wan_dev)"
+	[ -z "$wan" ] && return 0
+	if [ "$(nvd sc_mode each)" = "each" ]; then
+		touch "$STATE/seen"
+		connected_macs | while read -r m; do
+			grep -qx "$m" "$STATE/seen" || [ "$(wc -l < "$STATE/seen")" -ge $MAXDEV ] || echo "$m" >> "$STATE/seen"
+		done
+	fi
+	sig="$(signature "$wan")"
+	if [ "$sig" != "$(cat "$STATE/sig" 2>/dev/null)" ] || ! healthy "$wan"; then
+		build "$wan" && echo "$sig" > "$STATE/sig"
+	fi
+}
+
+need_mac() {
+	m="$(norm_mac "$1")"
+	[ -z "$m" ] && { echo "Invalid MAC address: '$1' (format aa:bb:cc:dd:ee:ff)" >&2; exit 1; }
+	echo "$m"
+}
+
+need_speed() {
+	k="$(to_kbit "$1")"
+	[ -z "$k" ] && { echo "Invalid speed: '$1' (examples: 5, 1.5, 512k, 0=unlimited)" >&2; exit 1; }
+	echo "$k"
+}
+
+saved() { nvram commit; rm -f "$STATE/sig"; sync_now; }
+
+rule_of() {
+	in_list "$1" "$(nvq sc_vip)" && { echo "VIP (full speed)"; return; }
+	c="$(custom_get "$1")"
+	if [ -n "$c" ]; then set -- $c; echo "custom $(fmt $1) down / $(fmt $2) up"; return; fi
+	if [ "$(nvd sc_mode each)" = "pool" ]; then echo "others (shared pool)"; else echo "others (own limit)"; fi
+}
+
+case "$1" in
+daemon)
+	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
+	echo $$ > "$PIDFILE"
+	mkdir -p "$STATE"; rm -f "$STATE/seen" "$STATE/sig"
+	sleep 30; export_devices; sleep 30
+	while :; do sync_now; sleep $POLL; done
+	;;
+on)
+	nvram set sc_enable=1
+	saved; echo "Speed Control is ON."
+	;;
+off)
+	nvram set sc_enable=0; saved; echo "Speed Control is OFF."
+	;;
+line)
+	[ $# -eq 3 ] || { echo "Usage: speedctl line DOWN UP   (your ISP plan, e.g. speedctl line 30 30)"; exit 1; }
+	cd="$(need_speed "$2")" || exit 1; cu="$(need_speed "$3")" || exit 1
+	nvram set sc_line_down="$2"; nvram set sc_line_up="$3"; saved
+	echo "Internet plan set to $(fmt $cd) down / $(fmt $cu) up."
+	;;
+others)
+	[ $# -eq 4 ] && { [ "$2" = each ] || [ "$2" = pool ]; } || { echo "Usage: speedctl others each|pool DOWN UP   (e.g. speedctl others each 5 1)"; exit 1; }
+	cd="$(need_speed "$3")" || exit 1; cu="$(need_speed "$4")" || exit 1
+	nvram set sc_mode="$2"; nvram set sc_down="$cd"; nvram set sc_up="$cu"; saved
+	if [ "$2" = each ]; then echo "Every other device: max $(fmt $cd) down / $(fmt $cu) up each."
+	else echo "All other devices together: max $(fmt $cd) down / $(fmt $cu) up."; fi
+	;;
+vip)
+	cm="$(need_mac "$3")" || exit 1
+	case "$2" in
+	add) in_list "$cm" "$(nvq sc_vip)" || nvram set sc_vip="$(echo $(nvq sc_vip) $cm)"; saved; echo "$cm is now VIP (full speed)." ;;
+	del) nvram set sc_vip="$(echo $(for x in $(nvq sc_vip); do [ "$x" != "$cm" ] && echo $x; done))"; saved; echo "$cm removed from VIP." ;;
+	*) echo "Usage: speedctl vip add|del MAC"; exit 1 ;;
+	esac
+	;;
+limit)
+	[ $# -eq 4 ] || { echo "Usage: speedctl limit MAC DOWN UP   (e.g. speedctl limit aa:bb:cc:dd:ee:ff 2 0.5)"; exit 1; }
+	cm="$(need_mac "$2")" || exit 1; cd="$(need_speed "$3")" || exit 1; cu="$(need_speed "$4")" || exit 1
+	nvram set sc_custom="$(echo $(for e in $(nvq sc_custom); do [ "${e%%,*}" != "$cm" ] && echo $e; done) $cm,$cd,$cu)"; saved
+	echo "$cm limited to $(fmt $cd) down / $(fmt $cu) up."
+	;;
+unlimit)
+	cm="$(need_mac "$2")" || exit 1
+	nvram set sc_custom="$(echo $(for e in $(nvq sc_custom); do [ "${e%%,*}" != "$cm" ] && echo $e; done))"; saved
+	echo "Custom limit removed from $cm."
+	;;
+apply)
+	rm -f "$STATE/sig"; sync_now; echo "Applied."
+	;;
+list)
+	printf "%-18s %-16s %-20s %s\n" "MAC" "IP" "NAME" "RULE"
+	connected_macs | while read -r m; do
+		printf "%-18s %-16s %-20s %s\n" "$m" "$(dev_ip "$m")" "$(dev_name "$m")" "$(rule_of "$m")"
+	done
+	;;
+status|"")
+	echo "Speed Control by Iqbal Mahmud"
+	echo "  enabled : $([ "$(nvd sc_enable 0)" = 1 ] && echo yes || echo no)"
+	echo "  plan    : $(fmt $(to_kbit "$(nvd sc_line_down 30)")) down / $(fmt $(to_kbit "$(nvd sc_line_up 30)")) up"
+	echo "  others  : $(nvd sc_mode each), $(fmt $(nvd sc_down 5000)) down / $(fmt $(nvd sc_up 1000)) up"
+	echo "  VIP     : $(nvq sc_vip)"
+	echo "  custom  : $(for e in $(nvq sc_custom); do echo "$e" | awk -F, '{printf "%s ", $1}'; done)"
+	echo "  WAN     : $(cat "$STATE/wan" 2>/dev/null || echo "not active")"
+	echo "  SFE     : $([ "$(nvq sfe_enable)" = 1 ] || [ "$(nvq sfe_enable)" = 2 ] && echo "on (turned off automatically when enabled)" || echo off)"
+	;;
+*)
+	sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
+	;;
+esac
diff --git a/trunk/user/scripts/wan_watchdog.sh b/trunk/user/scripts/wan_watchdog.sh
new file mode 100755
index 000000000..3429e4ab0
--- /dev/null
+++ b/trunk/user/scripts/wan_watchdog.sh
@@ -0,0 +1,157 @@
+#!/bin/sh
+#
+# Smart WAN Watchdog for Padavan (built for TP-Link TL-WR845N v4)
+#
+# When the internet stays down it escalates step by step:
+#   1. waits  wd_fail_time  seconds (short blips are ignored)
+#   2. restarts the WAN connection (PPPoE/DHCP) up to  wd_wan_retries  times,
+#      waiting  wd_wan_wait  seconds after each try
+#   3. reboots the router
+# If reboots keep not helping (ISP outage), each further reboot waits longer
+# (wd_backoff_base, doubled each time, capped at wd_backoff_max), so the router
+# never gets stuck in a reboot loop. The counter resets once the internet has
+# been stable for wd_stable_time seconds.
+#
+# All settings are nvram keys (Administration -> Console, or SSH):
+#   nvram set wd_fail_time=300 && nvram commit
+# Logs go to the system log with tag "wan_watchdog".
+
+TAG="wan_watchdog"
+PIDFILE="/var/run/wan_watchdog.pid"
+POLL=10
+
+if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
+	exit 0
+fi
+echo $$ > "$PIDFILE"
+
+nv() {
+	v="$(nvram get "$1" 2>/dev/null)"
+	case "$v" in
+		''|*[!0-9]*) echo "$2" ;;
+		*) echo "$v" ;;
+	esac
+}
+
+log() { logger -t "$TAG" "$*"; }
+
+uptime_s() { cut -d. -f1 /proc/uptime; }
+
+# 1 = internet OK, 0 = lost, 2 = unknown (still checking)
+check_internet() {
+	if [ "$(nvram get di_poll_mode)" = "1" ]; then
+		case "$(nvram get link_internet)" in
+			1) echo 1 ;;
+			0) echo 0 ;;
+			*) echo 2 ;;
+		esac
+		return
+	fi
+	# Fallback if built-in Internet detection was turned off
+	for ip in 1.1.1.1 8.8.8.8 9.9.9.9; do
+		if ping -c 1 -W 3 "$ip" >/dev/null 2>&1; then
+			echo 1
+			return
+		fi
+	done
+	echo 0
+}
+
+backoff_for() {
+	# extra wait before reboot number $1+1 when $1 reboots already happened in a row
+	n="$1"
+	[ "$n" -le 0 ] && { echo 0; return; }
+	b="$(nv wd_backoff_base 300)"
+	m="$(nv wd_backoff_max 1800)"
+	i=1
+	while [ "$i" -lt "$n" ] && [ "$i" -lt 12 ]; do
+		b=$((b * 2))
+		i=$((i + 1))
+	done
+	[ "$b" -gt "$m" ] && b="$m"
+	echo "$b"
+}
+
+lost_since=0
+ok_since=0
+wan_tries=0
+last_wan_restart=0
+warned_mode=0
+
+sleep "$(nv wd_boot_grace 120)"
+log "started (reboots in a row so far: $(nv wd_reboots 0))"
+
+while :; do
+	sleep "$POLL"
+
+	if [ "$(nv wd_enable 1)" != "1" ]; then
+		lost_since=0; wan_tries=0; last_wan_restart=0
+		continue
+	fi
+
+	# only in router mode
+	if [ "$(nvram get sw_mode)" != "1" ]; then
+		[ "$warned_mode" = 0 ] && log "not in router mode, watchdog idle"
+		warned_mode=1
+		continue
+	fi
+
+	now="$(uptime_s)"
+	st="$(check_internet)"
+
+	if [ "$st" = "1" ]; then
+		if [ "$lost_since" -ne 0 ]; then
+			log "internet restored after $((now - lost_since))s"
+		fi
+		lost_since=0; wan_tries=0; last_wan_restart=0
+		[ "$ok_since" -eq 0 ] && ok_since="$now"
+		if [ "$(nv wd_reboots 0)" -ne 0 ] && [ $((now - ok_since)) -ge "$(nv wd_stable_time 600)" ]; then
+			nvram set wd_reboots=0
+			nvram commit
+			log "connection stable, reboot backoff reset"
+		fi
+		continue
+	fi
+
+	[ "$st" = "2" ] && continue
+
+	ok_since=0
+	if [ "$lost_since" -eq 0 ]; then
+		lost_since="$now"
+		log "internet lost"
+	fi
+	down=$((now - lost_since))
+
+	fail_time="$(nv wd_fail_time 180)"
+	max_wan="$(nv wd_wan_retries 2)"
+	wan_wait="$(nv wd_wan_wait 90)"
+
+	[ "$down" -lt "$fail_time" ] && continue
+
+	# Step 2: restart WAN
+	if [ "$wan_tries" -lt "$max_wan" ]; then
+		if [ "$last_wan_restart" -eq 0 ] || [ $((now - last_wan_restart)) -ge "$wan_wait" ]; then
+			wan_tries=$((wan_tries + 1))
+			last_wan_restart="$now"
+			log "internet down ${down}s: restarting WAN (try $wan_tries/$max_wan)"
+			restart_wan
+		fi
+		continue
+	fi
+	[ "$last_wan_restart" -ne 0 ] && [ $((now - last_wan_restart)) -lt "$wan_wait" ] && continue
+
+	# Step 3: reboot, with backoff if previous reboots did not help
+	reboots="$(nv wd_reboots 0)"
+	extra="$(backoff_for "$reboots")"
+	need=$((fail_time + max_wan * wan_wait + extra))
+	if [ "$down" -ge "$need" ]; then
+		reboots=$((reboots + 1))
+		nvram set wd_reboots="$reboots"
+		nvram commit
+		log "internet down ${down}s, WAN restart did not help: rebooting (reboot #$reboots in a row)"
+		sync
+		sleep 2
+		reboot
+		exit 0
+	fi
+done
