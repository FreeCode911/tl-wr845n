+ + ' #logo { margin: 8px auto !important; }'
+ + ' .table tr > th:first-child:nth-last-child(2), .table tr > th:first-child:nth-last-child(2) + td { display: block; width: auto !important; }'
+ + ' .table tr > th:first-child:nth-last-child(2) + td { border-top: 0; padding-top: 0; }'
