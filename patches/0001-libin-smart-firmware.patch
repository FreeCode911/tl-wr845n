+// Branding + mobile layout (Libin build). Injected from here because
+// state.js is never cached by the router, while .png/.css are cached for 30 days.
+var im_mobile_css = ''
+ + '@media (max-width: 979px) {'
+ + ' body { overflow-x: hidden; }'
+ + ' .wrapper, .syslog_panel { width: auto !important; }'
