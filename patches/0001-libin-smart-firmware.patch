+                                        <tr>
+                                            <th width="50%"><#SC_down#> / <#SC_up#> (Mbps)</th>
+                                            <td>
+                                                <input type="text" maxlength="6" class="input" style="width: 60px;" name="sc_line_down" value="<% nvram_get_x("", "sc_line_down"); %>"/>&nbsp;/
+                                                <input type="text" maxlength="6" class="input" style="width: 60px;" name="sc_line_up" value="<% nvram_get_x("", "sc_line_up"); %>"/>
+                                                <div style="color:#888; margin-top:4px;"><#SC_plan_desc#></div>
+                                            </td>
