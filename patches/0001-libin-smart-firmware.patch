+ + ' .im-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }'
+ + ' .nav-tabs > li { float: none; display: inline-block; }'
+ + ' .box_head { font-size: 15px; }'
+ + '}';
+
+function apply_branding(){
+	var d = document, h = d.getElementsByTagName('head')[0], i, t;
+	if (h && !d.querySelector('meta[name="viewport"]')) {
+		var m = d.createElement('meta');
+		m.name = 'viewport';
+		m.content = 'width=device-width, initial-scale=1';
+		h.appendChild(m);
+	}
+	if (h && !d.getElementById('im_mobile_css')) {
+		var st = d.createElement('style');
+		st.id = 'im_mobile_css';
+		st.appendChild(d.createTextNode(im_mobile_css));
+		h.appendChild(st);
+	}
+	var lg = d.getElementById('logo');
+	if (lg)
+		lg.style.backgroundImage = 'url(/bootstrap/img/libin_logo.png)';
+	// wide tables (3+ columns) scroll sideways on small screens instead of overflowing
+	var tbls = d.querySelectorAll('table.table');
+	for (i = 0; i < tbls.length; i++) {
+		t = tbls[i];
+		if (t.parentNode && t.parentNode.className == 'im-scroll')
+			continue;
+		var r = t.rows && t.rows.length ? t.rows[t.rows.length > 1 ? 1 : 0] : null;
+		if (!r || r.cells.length < 3)
+			continue;
