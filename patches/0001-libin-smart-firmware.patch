+                                    </table>
+
+                                    <table width="100%" cellpadding="4" cellspacing="0" class="table">
+                                        <tr>
+                                            <th colspan="2" style="background-color: #E3E3E3;"><#SC_others#></th>
+                                        </tr>
+                                        <tr>
+                                            <th width="50%"><#SC_mode#></th>
+                                            <td>
+                                                <select name="sc_mode" class="input" style="width: 260px;" onchange="mode_changed();">
+                                                    <option value="each" <% nvram_match_x("", "sc_mode", "each", "selected"); %>><#SC_mode_each#></option>
+                                                    <option value="pool" <% nvram_match_x("", "sc_mode", "pool", "selected"); %>><#SC_mode_pool#></option>
+                                                </select>
+                                            </td>
+                                        </tr>
+                                        <tr>
+                                            <th><#SC_down#> / <#SC_up#> (Mbps)</th>
+                                            <td>
+                                                <input type="text" maxlength="7" class="input" style="width: 60px;" id="od_mbps" value=""/>&nbsp;/
+                                                <input type="text" maxlength="7" class="input" style="width: 60px;" id="ou_mbps" value=""/>
+                                                <div style="color:#888; margin-top:4px;">
+                                                    <span id="hint_each"><#SC_hint_each#></span>
