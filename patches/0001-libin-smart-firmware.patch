+                    <div class="span12">
+                        <div class="box well grad_colour_dark_blue">
+                            <h2 class="box_head round_top"><#menu5_10#> - <#menu5_10_4#></h2>
+                            <div class="round_bottom">
+                                <div class="row-fluid">
+                                    <div id="tabMenu" class="submenuBlock"></div>
+                                    <div class="alert alert-info" style="margin: 10px;"><#SC_desc#></div>
+
+                                    <table width="100%" cellpadding="4" cellspacing="0" class="table">
+                                        <tr>
+                                            <th width="50%"><#SC_enable#></th>
+                                            <td>
+                                                <select name="sc_enable" class="input" onchange="enable_changed();">
+                                                    <option value="0" <% nvram_match_x("", "sc_enable", "0", "selected"); %>><#checkbox_No#></option>
+                                                    <option value="1" <% nvram_match_x("", "sc_enable", "1", "selected"); %>><#checkbox_Yes#></option>
+                                                </select>
